      <SolidColorBrush x:Key="TagPillBackground" Color="#1F000000" />
      <SolidColorBrush x:Key="UnpushedPillBackground" Color="#8C959F" />
      <!-- The simple mode, in GitHub Desktop's neutral cool greys (Fluent's acrylic popups look warm next to it). -->
      <SolidColorBrush x:Key="SimpleToolbarBackground" Color="#F6F8FA" />
      <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PopupBorderBrush" Color="#D0D7DE" />
      <SolidColorBrush x:Key="SyntaxKeywordForeground" Color="#CF222E" />
      <SolidColorBrush x:Key="SyntaxStringForeground" Color="#0A3069" />
      <SolidColorBrush x:Key="SyntaxCommentForeground" Color="#6E7781" />
      <SolidColorBrush x:Key="SyntaxNumberForeground" Color="#0550AE" />
      <SolidColorBrush x:Key="SyntaxTagForeground" Color="#116329" />
      <SolidColorBrush x:Key="SyntaxAttributeForeground" Color="#953800" />
      <SolidColorBrush x:Key="RefBadgeBackground" Color="#CFE3FA" />
      <SolidColorBrush x:Key="RefBadgeForeground" Color="#0B3A75" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="CommitMessageBackground" Color="#F2F2F2" />
      <SolidColorBrush x:Key="LinkForeground" Color="#0066CC" />
      <!-- The status boxes of changed files (added / modified / deleted). -->
      <SolidColorBrush x:Key="FileStatusAddedBrush" Color="#1A7F37" />
      <SolidColorBrush x:Key="FileStatusModifiedBrush" Color="#9A6700" />
      <SolidColorBrush x:Key="FileStatusDeletedBrush" Color="#CF222E" />
    </ResourceDictionary>
