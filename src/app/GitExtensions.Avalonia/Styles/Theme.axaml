<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:GitExtensions.Desktop.Views">
  <!-- Semantic, theme-aware colors. Always reference with DynamicResource so a theme switch re-skins live. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
      <SolidColorBrush x:Key="AccentTextForeground" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DialogBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MenuBarBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ToolbarBackground" Color="Transparent" />
      <SolidColorBrush x:Key="SidebarBackground" Color="Transparent" />
      <SolidColorBrush x:Key="StatusBarBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ErrorBannerBackground" Color="#FDE7E9" />
      <SolidColorBrush x:Key="ErrorBannerForeground" Color="#7A1212" />
      <SolidColorBrush x:Key="ErrorTextForeground" Color="#B3261E" />
      <SolidColorBrush x:Key="SuccessTextForeground" Color="#1B6E2E" />
      <SolidColorBrush x:Key="DiffAddedBackground" Color="#C8FFC8" />
      <SolidColorBrush x:Key="DiffAddedGutterBackground" Color="#F3FFF3" />
      <SolidColorBrush x:Key="DiffRemovedBackground" Color="#FFC8C8" />
