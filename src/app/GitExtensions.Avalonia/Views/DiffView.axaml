<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:diff="using:GitExtensions.Desktop.Diff"
             xmlns:views="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.DiffView"
             x:DataType="vm:FileDiffViewModel">

  <UserControl.Styles>
    <!-- Like the original: the line number columns are a light tint, the text of the line has the strong colour. -->
    <Style Selector="Border.added"><Setter Property="Background" Value="{DynamicResource DiffAddedGutterBackground}" /></Style>
    <Style Selector="Border.added StackPanel.text"><Setter Property="Background" Value="{DynamicResource DiffAddedBackground}" /></Style>
    <Style Selector="Border.removed"><Setter Property="Background" Value="{DynamicResource DiffRemovedGutterBackground}" /></Style>
    <Style Selector="Border.removed StackPanel.text"><Setter Property="Background" Value="{DynamicResource DiffRemovedBackground}" /></Style>
    <Style Selector="Button.hunkAction">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="Border.hunk"><Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" /></Style>

    <!-- "compact" (the Commit window, like the original): no file name and stage buttons above the diff; the bar only appears for a line selection. -->
    <!-- "noStaging" (the Changes tab): files are included with their check boxes, so no stage buttons, hunk buttons or line
         selection bar. Discarding stays in the file context menu. -->
    <!-- Hidden through their hosts: the controls themselves bind IsVisible, and a local binding wins over a style. -->
    <Style Selector="views|DiffView.noStaging Panel#SelectionToolbarHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|DiffView.noStaging StackPanel.hunkActions"><Setter Property="IsVisible" Value="False" /></Style>
    <!-- No git plumbing above the diff (the "diff", "index" and old/new file lines): the file name is already shown, like GitHub Desktop. -->
    <Style Selector="views|DiffView.noStaging Border.fileHeader"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|DiffView.noStaging WrapPanel#FileActions"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|DiffView.noStaging MenuItem#StageSelectedMenuItem"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|DiffView.noStaging MenuItem#UnstageSelectedMenuItem"><Setter Property="IsVisible" Value="False" /></Style>

    <Style Selector="views|DiffView.compact Border#FileHeader">
      <Setter Property="IsVisible" Value="{Binding HasSelection}" />
    </Style>
    <Style Selector="views|DiffView.compact TextBlock#FileNameText"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|DiffView.compact WrapPanel#FileActions"><Setter Property="IsVisible" Value="False" /></Style>
  </UserControl.Styles>

  <DockPanel>
    <Border x:Name="DiscardConfirmation" DockPanel.Dock="Top" Padding="8,6" IsVisible="{Binding IsConfirmingDiscard}"
            Background="{DynamicResource ErrorBannerBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="ConfirmationMessage" Text="{Binding ConfirmationText}" Foreground="{DynamicResource ErrorBannerForeground}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="ConfirmDiscardButton" Content="Discard" Command="{Binding ConfirmDiscardCommand}" Margin="8,0,6,0" />
        <Button Grid.Column="2" x:Name="CancelDiscardButton" Content="Cancel" Command="{Binding CancelDiscardCommand}" />
      </Grid>
    </Border>

    <Border x:Name="FileHeader" DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
        <TextBlock x:Name="FileNameText" Text="{Binding File.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <WrapPanel x:Name="FileActions" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
          <Button Content="Stage" Command="{Binding StageCommand}" Margin="0,0,6,0" />
          <Button Content="Unstage" Command="{Binding UnstageCommand}" Margin="0,0,6,0" />
          <Button Content="Stage all" Command="{Binding StageAllCommand}" Margin="0,0,6,0" />
          <Button Content="Unstage all" Command="{Binding UnstageAllCommand}" />
        </WrapPanel>
        <Panel x:Name="SelectionToolbarHost" Grid.Row="2" Grid.ColumnSpan="2">
          <WrapPanel x:Name="SelectionToolbar" Orientation="Horizontal" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectedLineCount, StringFormat='{}{0} selected'}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
            <Button x:Name="StageSelectedButton" Content="Stage selected lines" ToolTip.Tip="Stage the selected lines (S)" Command="{Binding StageSelectedCommand}" IsVisible="{Binding CanStageSelected}" Margin="0,0,6,0" />
            <Button x:Name="UnstageSelectedButton" Content="Unstage selected lines" ToolTip.Tip="Unstage the selected lines (U)" Command="{Binding UnstageSelectedCommand}" IsVisible="{Binding CanUnstageSelected}" Margin="0,0,6,0" />
            <Button x:Name="DiscardSelectedButton" Content="Discard selected lines" ToolTip.Tip="Reset the selected lines (R)" Command="{Binding DiscardSelectedCommand}" IsVisible="{Binding CanDiscardSelected}" Margin="0,0,6,0" />
          </WrapPanel>
        </Panel>
      </Grid>
    </Border>

    <Panel>
      <ItemsControl x:Name="DiffLines" ItemsSource="{Binding Lines}" Focusable="True" KeyDown="OnDiffKeyDown">
        <ItemsControl.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="StageSelectedMenuItem" Header="Stage selected line(s)" InputGesture="S" Command="{Binding StageSelectedCommand}" IsEnabled="{Binding CanStageSelected}" />
            <MenuItem x:Name="UnstageSelectedMenuItem" Header="Unstage selected line(s)" InputGesture="U" Command="{Binding UnstageSelectedCommand}" IsEnabled="{Binding CanUnstageSelected}" />
            <MenuItem x:Name="DiscardSelectedMenuItem" Header="Reset selected line(s)" InputGesture="R" Command="{Binding DiscardSelectedCommand}" IsEnabled="{Binding CanDiscardSelected}" />
          </ContextMenu>
        </ItemsControl.ContextMenu>
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="diff:DiffLine">
            <Border PointerPressed="OnLinePressed"
                    Classes.added="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Added}}"
                    Classes.removed="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Removed}}"
                    Classes.fileHeader="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Header}}"
                    Classes.hunk="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Hunk}}">
              <Grid ColumnDefinitions="44,44,*" Opacity="{Binding Kind, Converter={x:Static views:DiffLineBrushes.TextOpacity}}">
                <TextBlock Text="{Binding OldNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" Text="{Binding NewNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                <StackPanel Grid.Column="2" Classes="text" Orientation="Horizontal">
                  <TextBlock views:SyntaxText.Line="{Binding}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                  <StackPanel Classes="hunkActions" Orientation="Horizontal">
                    <Button Classes="hunkAction" Content="Stage hunk" Tag="stage" Click="OnHunkAction" IsVisible="{Binding CanStageHunk}" />
                    <Button Classes="hunkAction" Content="Unstage hunk" Tag="unstage" Click="OnHunkAction" IsVisible="{Binding CanUnstageHunk}" />
                    <Button Classes="hunkAction" Content="Discard hunk" Tag="discard" Click="OnHunkAction" IsVisible="{Binding CanDiscardHunk}" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.ColumnSpan="3" Background="{DynamicResource DiffSelectionOverlay}" IsHitTestVisible="False" IsVisible="{Binding IsSelected}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="MessageText" Text="{Binding Message}" Opacity="0.6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Panel>
  </DockPanel>
</UserControl>
