<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:diff="using:GitExtensions.Desktop.Diff"
             xmlns:views="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.RevisionDiffView"
             x:DataType="vm:RevisionDiffViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://GitExtensions.Avalonia/Styles/FileStatus.axaml" />
    <!-- "desktop" (the simple mode's history): GitHub Desktop style file rows, taller, flat list first. -->
    <Style Selector="Grid.desktopRow"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|RevisionDiffView.desktop Border.fileHeader"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|RevisionDiffView.desktop Grid.desktopRow"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="views|RevisionDiffView.desktop Grid.classicRow"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="views|RevisionDiffView.desktop ListBox#FileList ListBoxItem">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.added"><Setter Property="Background" Value="{DynamicResource DiffAddedBackground}" /></Style>
    <Style Selector="Border.removed"><Setter Property="Background" Value="{DynamicResource DiffRemovedBackground}" /></Style>
    <Style Selector="Border.hunk"><Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" /></Style>
    <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{DynamicResource SuccessTextForeground}" /></Style>
    <Style Selector="TextBlock.deleted"><Setter Property="Foreground" Value="{DynamicResource ErrorTextForeground}" /></Style>
    <!-- Compact rows like the original's file list. -->
    <Style Selector="ListBox#FileList ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TreeView#FileTree">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TreeView#FileTree TreeViewItem" x:DataType="vm:ChangeTreeNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource DottedTreeItemTheme}" />
    </Style>
    <Style Selector="ToggleButton.layout">
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.layout:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="260,4,*" RowDefinitions="Auto,*">
    <Border x:Name="RevertConfirmation" Grid.ColumnSpan="3" Padding="8,6" IsVisible="{Binding IsConfirmingRevert}" Background="{DynamicResource ErrorBannerBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="RevertConfirmationMessage" Text="{Binding RevertConfirmationText}" Foreground="{DynamicResource ErrorBannerForeground}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="ConfirmRevertButton" Grid.Column="1" Content="Revert" Command="{Binding ConfirmRevertCommand}" Margin="8,0,6,0" />
        <Button x:Name="CancelRevertButton" Grid.Column="2" Content="Cancel" Command="{Binding CancelRevertCommand}" />
      </Grid>
    </Border>
    <DockPanel Grid.Row="1" Grid.Column="0">
      <!-- How the files are listed, like the original's "Sort and group by": flat, by folder, by extension. -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="4,3,4,0">
        <ToggleButton x:Name="ListLayoutButton" Classes="layout" IsChecked="{Binding GroupByNone}" ToolTip.Tip="Flat list of paths">
          <views:AppIcon IconName="File" />
        </ToggleButton>
        <ToggleButton x:Name="TreeLayoutButton" Classes="layout" IsChecked="{Binding GroupByPath}" ToolTip.Tip="Group by path (folder tree)">
          <views:AppIcon IconName="FileTree" />
        </ToggleButton>
        <ToggleButton x:Name="ExtensionLayoutButton" Classes="layout" IsChecked="{Binding GroupByExtension}" ToolTip.Tip="Group by file extension">
          <views:AppIcon IconName="SortBy" />
        </ToggleButton>
      </StackPanel>
      <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="4,3,4,2" MinHeight="22" Padding="5,1" FontSize="12" PlaceholderText="Filter files…" Text="{Binding FilterText}" />
      <Panel>
        <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Padding="0" IsVisible="{Binding !ShowTree}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangedFileViewModel">
              <Panel>
              <Grid Classes="classicRow" ColumnDefinitions="16,*,Auto" ColumnSpacing="5" Background="Transparent">
                <views:AppIcon IconName="{Binding StatusIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="staged" FontSize="11" Opacity="0.6" IsVisible="{Binding IsStaged}" VerticalAlignment="Center" />
              </Grid>
              <!-- The simple mode: like the Changes list, the folder dimmed, the file name bright and the status box on the right. -->
              <Grid Classes="desktopRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" Background="Transparent" ToolTip.Tip="{Binding DisplayName}">
                <TextBlock FontSize="12.5" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis">
                  <Run Text="{Binding DirectoryPrefix}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" /><Run Text="{Binding FileName}" />
                </TextBlock>
                <Border Grid.Column="1" Classes="status" ToolTip.Tip="{Binding Description}"
                        Classes.added="{Binding IsAdded}" Classes.deleted="{Binding IsDeleted}"
                        Classes.renamed="{Binding IsRenamed}" Classes.conflict="{Binding IsConflicted}">
                  <Panel>
                    <Path Data="M0,3.5 H7 M3.5,0 V7" IsVisible="{Binding IsAdded}" />
                    <Path Data="M0,3.5 H7" IsVisible="{Binding IsDeleted}" />
                    <Path Data="M0,3.5 H6 M3.5,1 L6,3.5 L3.5,6" IsVisible="{Binding IsRenamed}" />
                    <Path Data="M3.5,0 V4.5 M3.5,6 V7" IsVisible="{Binding IsConflicted}" />
                    <Ellipse IsVisible="{Binding IsModified}" />
                  </Panel>
                </Border>
              </Grid>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TreeView x:Name="FileTree" ItemsSource="{Binding Tree}" IsVisible="{Binding ShowTree}" Padding="2,0"
                  ItemContainerTheme="{StaticResource DottedTreeItemTheme}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:ChangeTreeNode">
              <StackPanel Orientation="Horizontal" Spacing="3" Background="Transparent" ToolTip.Tip="{Binding File.Name}">
                <views:AppIcon IconName="{Binding StatusIcon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PlainLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="Transparent" />

    <DockPanel Grid.Row="1" Grid.Column="2">
      <Border x:Name="NoticeBanner" DockPanel.Dock="Top" Padding="8,3" Background="{DynamicResource DiffHunkBackground}"
              IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap" />
      </Border>
      <Panel>
        <ItemsControl x:Name="DiffLines" ItemsSource="{Binding Lines}">
          <ItemsControl.Template>
            <ControlTemplate>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="diff:DiffLine">
              <Border Classes.added="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Added}}"
                      Classes.removed="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Removed}}"
                      Classes.fileHeader="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Header}}"
                      Classes.hunk="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Hunk}}">
                <Grid ColumnDefinitions="44,44,*" Opacity="{Binding Kind, Converter={x:Static views:DiffLineBrushes.TextOpacity}}">
                  <TextBlock Text="{Binding OldNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding NewNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" views:SyntaxText.Line="{Binding}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="{DynamicResource EditorFontSize}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="MessageText" Text="{Binding Message}" Opacity="0.6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
