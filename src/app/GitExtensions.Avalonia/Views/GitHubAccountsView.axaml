<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.GitHubAccountsView"
             x:DataType="vm:GitHubAccountsViewModel"
             Background="{DynamicResource DialogBackground}">

  <UserControl.Styles>
    <StyleInclude Source="avares://GitExtensions.Avalonia/Styles/SimpleGlyphs.axaml" />
    <Style Selector="Button.accountRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.accountRow.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.accountRow.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16">
    <!-- Why it opened (a failed push), and errors from gh. -->
    <Border DockPanel.Dock="Top" Classes="hint" Padding="10,8" CornerRadius="6" Margin="0,0,0,10" IsVisible="{Binding HasHint}"
            Background="{DynamicResource DiffHunkBackground}">
      <TextBlock x:Name="AccountsHint" Text="{Binding Hint}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="6" Margin="0,0,0,10" IsVisible="{Binding HasError}"
            Background="{DynamicResource ErrorBannerBackground}">
      <TextBlock x:Name="AccountsError" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBannerForeground}" />
    </Border>

    <!-- Actions -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
      <Button x:Name="AddAccountButton" Content="Add account…" Command="{Binding AddAccountCommand}" ToolTip.Tip="Sign in another GitHub account (opens the GitHub CLI's browser sign-in)" />
      <Button x:Name="RefreshAccountsButton" Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button x:Name="CancelAccountsButton" Grid.Column="3" Content="Cancel" IsCancel="True" Command="{Binding CloseCommand}" />
      <Button x:Name="ApplyAccountButton" Grid.Column="4" Classes="accent" IsDefault="True" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" />
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
      <RadioButton x:Name="ThisRepositoryOnly" GroupName="AccountScope" IsChecked="{Binding !UseEverywhere}" Content="Use it for this repository only" />
      <RadioButton x:Name="EverywhereScope" GroupName="AccountScope" IsChecked="{Binding UseEverywhere}" Content="Make it the active account for all repositories" />
      <Button x:Name="UseActiveAccountButton" Classes="link" Content="This repository: go back to the active account" Command="{Binding UseActiveAccountCommand}"
              IsVisible="{Binding HasRepositoryAccount}" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LinkForeground}" />
    </StackPanel>

    <!-- The signed-in accounts -->
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Signed-in GitHub accounts" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="0,0,0,6" />
      <ScrollViewer>
        <ItemsControl x:Name="AccountList" ItemsSource="{Binding Accounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GitHubAccountRow">
              <Button Classes="accountRow" Classes.selected="{Binding IsSelected}" Margin="0,0,0,4"
                      Command="{Binding #AccountList.((vm:GitHubAccountsViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource TagPillBackground}">
                    <Path Classes="glyph" Data="{StaticResource GlyphPerson}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Login}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.65" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Path Grid.Column="2" Classes="glyph" Data="{StaticResource GlyphCheck}" IsVisible="{Binding IsSelected}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>
